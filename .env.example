# Database
DATABASE_URL=postgresql+asyncpg://openagentic:openagentic@postgres:5432/openagentic

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM (LiteLLM 统一网关) ──
# 格式: <provider>/<model>，如 openai/gpt-4o、deepseek/deepseek-v4-flash
# 默认 DeepSeek，改 .env 即切 provider
LITELLM_DEFAULT_MODEL=openai/deepseek-v4-flash

# ┌─ DeepSeek（默认）─┐
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# └────────────────────┘

# ┌─ OpenAI ──────────┐
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# LITELLM_DEFAULT_MODEL=openai/gpt-4o
# └────────────────────┘

# ┌─ Anthropic ───────┐
# ANTHROPIC_API_KEY=sk-ant-your-key
# LITELLM_DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514
# └────────────────────┘

# ┌─ 硅基流动 ────────┐
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# LITELLM_DEFAULT_MODEL=openai/deepseek-ai/DeepSeek-V3
# └────────────────────┘

# ┌─ 通义千问 ────────┐
# OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LITELLM_DEFAULT_MODEL=openai/qwen-plus
# └────────────────────┘

# Optional embedding provider settings (reserved for Phase 4 RAG)
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_API_KEY=
# Persistent provider profile file for multi-LLM runtime config
MODEL_PROVIDER_CONFIG_PATH=.openagentic/model_providers.json

# CLI (openagentic ReAct：单条用户消息内模型↔工具最大轮数，可在 .env 覆盖)
CLI_REACT_MAX_ITERATIONS=1000

# App
APP_NAME=OpenAgentic
APP_ENV=development
APP_PORT=8000
APP_LOG_LEVEL=INFO
