# Database
DATABASE_URL=postgresql+asyncpg://openagentic:openagentic@postgres:5432/openagentic

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM (LiteLLM)
LITELLM_DEFAULT_MODEL=ollama/qwen3:14b
OLLAMA_API_BASE=http://host.docker.internal:11434

# App
APP_NAME=OpenAgentic
APP_ENV=development
APP_PORT=8000
APP_LOG_LEVEL=INFO
