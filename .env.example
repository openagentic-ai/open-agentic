# Database
DATABASE_URL=postgresql+asyncpg://openagentic:openagentic@postgres:5432/openagentic

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM (LiteLLM)
LITELLM_DEFAULT_MODEL=ollama/qwen3:14b
OLLAMA_API_BASE=http://host.docker.internal:11434

# OpenAI-compatible provider (used by CLI when --provider=openai or auto-detected)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional embedding provider settings (reserved for Phase 4 RAG)
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_API_KEY=

# App
APP_NAME=OpenAgentic
APP_ENV=development
APP_PORT=8000
APP_LOG_LEVEL=INFO
